#!/usr/bin/env python3
"""Send privacy-conscious Codex, Claude Code, and task alerts via ntfy."""

from __future__ import annotations

import json
import os
import socket
import sys
from datetime import datetime
from logging import Formatter, getLogger
from logging.handlers import RotatingFileHandler
from pathlib import Path
from typing import Any
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

DEFAULT_CONFIG_PATH = Path.home() / ".config" / "ai-notify" / "config.json"
DEFAULT_LOG_PATH = Path.home() / ".local" / "state" / "ai-notify" / "notify.log"


def config_path() -> Path:
    return Path(os.environ.get("AI_NOTIFY_CONFIG", DEFAULT_CONFIG_PATH)).expanduser()


def log_path() -> Path:
    return Path(os.environ.get("AI_NOTIFY_LOG", DEFAULT_LOG_PATH)).expanduser()


def logger():
    path = log_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    log = getLogger("ai-notify")
    if not log.handlers:
        handler = RotatingFileHandler(path, maxBytes=1_000_000, backupCount=2)
        handler.setFormatter(Formatter("%(asctime)s %(levelname)s %(message)s"))
        log.addHandler(handler)
        log.setLevel("INFO")
    return log


def load_config() -> dict[str, Any]:
    path = config_path()
    with path.open("r", encoding="utf-8") as handle:
        config = json.load(handle)
    if not config.get("server_url") or not config.get("topic"):
        raise ValueError(f"Missing server_url or topic in {path}")
    if config["topic"] == "replace-with-a-long-random-topic":
        raise ValueError(f"Replace the example topic in {path}")
    return config


def read_json(raw: str) -> dict[str, Any]:
    if not raw.strip():
        return {}
    value = json.loads(raw)
    return value if isinstance(value, dict) else {}


def stdin_json() -> dict[str, Any]:
    return read_json(sys.stdin.read())


def project_name(cwd: str) -> str:
    cleaned = cwd.rstrip(os.sep)
    return Path(cleaned).name if cleaned else cwd


def short_id(value: Any) -> str:
    text = str(value or "")
    return text[:8] if text else "-"


def base_lines(config: dict[str, Any], event: dict[str, Any]) -> list[str]:
    cwd = str(event.get("cwd") or os.getcwd())
    host = str(config.get("host_label") or socket.gethostname())
    lines = [
        f"Host: {host}",
        f"Project: {project_name(cwd)}",
        f"Time: {datetime.now().astimezone().strftime('%Y-%m-%d %H:%M:%S %Z')}",
    ]
    session = event.get("thread-id") or event.get("session_id")
    if session:
        lines.append(f"Session: {short_id(session)}")
    return lines


def describe(
    source: str, args: list[str], config: dict[str, Any]
) -> tuple[str, str, int, list[str]]:
    if source == "codex":
        event = read_json(args[0] if args else "{}")
        if event.get("type") not in (None, "agent-turn-complete"):
            raise SystemExit(0)
        return (
            "Codex finished a turn",
            "\n".join(base_lines(config, event)),
            3,
            ["robot", "white_check_mark"],
        )

    if source.startswith("claude-"):
        event = stdin_json()
        lines = base_lines(config, event)
        if source == "claude-stop":
            background = event.get("background_tasks") or []
            schedules = event.get("session_crons") or []
            if background or schedules:
                lines.append(
                    f"Background tasks: {len(background)}; scheduled tasks: {len(schedules)}"
                )
                return (
                    "Claude paused; background work is still running",
                    "\n".join(lines),
                    3,
                    ["robot", "hourglass_flowing_sand"],
                )
            return (
                "Claude finished a turn",
                "\n".join(lines),
                3,
                ["robot", "white_check_mark"],
            )
        if source == "claude-failure":
            lines.append(f"Error type: {event.get('error') or 'unknown'}")
            return "Claude failed", "\n".join(lines), 5, ["robot", "warning"]
        if source == "claude-permission":
            tool = event.get("tool_name")
            if tool:
                lines.append(f"Requested tool: {tool}")
            return (
                "Claude is waiting for permission",
                "\n".join(lines),
                5,
                ["robot", "lock"],
            )
        if source == "claude-needs-input":
            lines.append(
                f"Notification type: {event.get('notification_type') or 'needs_input'}"
            )
            return (
                "Claude needs your input",
                "\n".join(lines),
                5,
                ["robot", "question"],
            )
        if source == "claude-session-end":
            lines.append(f"Reason: {event.get('reason') or 'unknown'}")
            return "Claude session ended", "\n".join(lines), 3, ["robot", "stop_sign"]

    if source == "task":
        if len(args) != 4:
            raise ValueError("task requires STATUS NAME EXIT_CODE ELAPSED_SECONDS")
        status, name, exit_code, elapsed = args
        lines = base_lines(config, {"cwd": os.getcwd()})
        lines.extend(
            [f"Task: {name}", f"Exit code: {exit_code}", f"Elapsed: {elapsed}s"]
        )
        if status == "success":
            return f"Task completed: {name}", "\n".join(lines), 4, ["white_check_mark"]
        if status == "interrupted":
            return f"Task interrupted: {name}", "\n".join(lines), 4, ["warning"]
        return f"Task failed: {name}", "\n".join(lines), 5, ["rotating_light"]

    if source == "test":
        lines = base_lines(config, {"cwd": os.getcwd()})
        lines.append("Codex, Claude Code, and task notifications are connected.")
        return "AI server notification test", "\n".join(lines), 4, ["tada", "robot"]

    raise ValueError(f"Unknown source: {source}")


def publish(
    config: dict[str, Any], title: str, message: str, priority: int, tags: list[str]
) -> None:
    body = json.dumps(
        {
            "topic": config["topic"],
            "title": title,
            "message": message,
            "priority": priority,
            "tags": tags,
        },
        ensure_ascii=False,
    ).encode("utf-8")
    headers = {"Content-Type": "application/json; charset=utf-8"}
    token = str(config.get("token") or "").strip()
    if token:
        headers["Authorization"] = f"Bearer {token}"
    request = Request(
        str(config["server_url"]).rstrip("/"),
        data=body,
        headers=headers,
        method="POST",
    )
    if os.environ.get("AI_NOTIFY_DRY_RUN") == "1":
        return
    with urlopen(request, timeout=8) as response:
        if not 200 <= response.status < 300:
            raise RuntimeError(f"ntfy returned HTTP {response.status}")


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: ai-notify SOURCE [ARGS...]", file=sys.stderr)
        return 2
    source, args = sys.argv[1], sys.argv[2:]
    strict = source == "test"
    try:
        config = load_config()
        title, message, priority, tags = describe(source, args, config)
        publish(config, title, message, priority, tags)
        logger().info("sent source=%s title=%s", source, title)
        if strict:
            print("ntfy test notification sent")
        return 0
    except SystemExit:
        return 0
    except (OSError, ValueError, json.JSONDecodeError, HTTPError, URLError, RuntimeError) as exc:
        logger().error("send failed source=%s error=%s", source, exc)
        if strict:
            print(f"notification failed: {exc}", file=sys.stderr)
            return 1
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
